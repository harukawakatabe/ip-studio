# 这是模板文件，会随代码一起提交 —— 不要在这里填真实密钥。
# 复制成 .env 再填：cp .env.example .env（.env 已在 .gitignore 里）

# ── 模型通道（不配置则运行在演示模式：流程完整、内容是本地模板）──

# 方式 A（推荐）：通道链 —— 一组 Anthropic 协议端点，前面的挂了自动切后面的。
# 固定顺序 anthropic → kimi → mimo → glm → deepseek，没配 key 的通道自动跳过；
# 官方 Claude 只认 ANTHROPIC_API_KEY，不认 ANTHROPIC_AUTH_TOKEN——后者常是
# 本机 Claude Code 代理的变量，误接进来会把请求打到代理上。
# LLM_CHAIN=anthropic,kimi,mimo,glm,deepseek   # 可重排 / 删减
#
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-opus-5-5
#
# LLM_KIMI_BASE_URL=https://api.kimi.com/coding/
# LLM_KIMI_API_KEY=sk-xxx
# LLM_KIMI_MODEL=kimi-k2.5
#
# LLM_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# LLM_MIMO_API_KEY=xxx
# LLM_MIMO_MODEL=mimo-v2.5
#
# LLM_GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# LLM_GLM_API_KEY=xxx
# LLM_GLM_MODEL=glm-5.3
#
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODEL=deepseek-v4-flash

# 方式 B：只锁官方 Claude（不兜底）
# LLM_PROVIDER=anthropic

# 方式 C：任意 OpenAI 兼容接口（DeepSeek / Kimi / 通义千问 / vLLM / Ollama）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 方式 D：强制演示模式
# LLM_PROVIDER=mock

# ── 采样参数（可选，中文长文跑飞时往下调）──
# LLM_TEMPERATURE=1.0        # 正文生成，默认 1.0；1.3 以上容易语无伦次
# LLM_TEMPERATURE_JSON=0.6   # 结构化输出（选题、题材、热点、检查）
# LLM_TOP_P=0.95

# ── 管理后台 ──
# 后台在 /admin，独立账号，第一次访问时在页面上创建管理员，不需要在这里配置

# ── 服务 ──
# PORT=5177
# DB_PATH=./data/app.db

# ── 文章配图（可选；不配置则用本地占位图，流程照样能跑通）──
# 不填 IMAGE_PROVIDER 时：有 DASHSCOPE_API_KEY 就走通义万相，否则演示模式
# IMAGE_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash     # 也可换 wanx2.1-t2i-turbo / -plus
#
# 或走任意 OpenAI 兼容的 /v1/images/generations
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=sk-...
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
#
# 强制演示模式（调试整条链路时用，一张图都不会花钱）
# IMAGE_PROVIDER=mock

# ── 支付（微信 + 支付宝，都需要企业主体和已备案域名）──
# PAY_PROVIDER=mock            # mock = 本地假支付，把流程跑通；上线换成 wechat / alipay
# PAY_NOTIFY_BASE=https://你的域名   # 回调地址前缀，必须公网可达
#
# 微信支付 v3
# WX_MCHID=            # 商户号
# WX_APPID=            # 公众号/应用 appid
# WX_CERT_SERIAL=      # 商户证书序列号
# WX_API_V3_KEY=       # APIv3 密钥（32 位）
# WX_PRIVATE_KEY=      # 商户私钥 PEM 内容
#
# 支付宝当面付
# ALI_APP_ID=
# ALI_PRIVATE_KEY=     # 应用私钥 PEM
# ALI_PUBLIC_KEY=      # 支付宝公钥 PEM（验签用，别填成自己的公钥）

# 敏感配置的加密密钥。后台填的商户私钥用它加密入库——
# 没有它，数据库里的私钥等于明文。设一个随机的长字符串，
# 并且**不要和数据库放在一起备份**（一起丢了就等于没加密）。
# SECRET_KEY=
